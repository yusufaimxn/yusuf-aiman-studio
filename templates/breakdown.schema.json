{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene breakdown",
  "type": "object",
  "required": ["slug", "total_duration_s", "scenes"],
  "properties": {
    "slug": {"type": "string"},
    "total_duration_s": {"type": "number"},
    "scenes": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["id", "purpose", "start_s", "duration_s", "goal", "visual"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "purpose": {"enum": ["hook", "setup", "explain", "example", "takeaway", "outro", "transition"]},
        "start_s": {"type": "number", "minimum": 0},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "goal": {"type": "string", "description": "What the viewer understands after this scene"},
        "visual": {"type": "string", "description": "What is on screen"},
        "template": {"type": "string", "description": "scenes/ component or templates/ scene used"},
        "environment": {"type": "string"},
        "characters": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {
          "name": {"enum": ["yusuf", "aiman"]}, "expression": {"type": "string"}, "pose": {"type": "string"}, "outfit": {"type": "string"}}}},
        "dialogue": {"type": "array", "items": {"type": "object", "required": ["speaker", "text"], "properties": {
          "speaker": {"enum": ["yusuf", "aiman", "narrator"]}, "text": {"type": "string"}, "emotion": {"type": "string"}}}},
        "on_screen_text": {"type": "array", "items": {"type": "string"}},
        "assets": {"type": "array", "items": {"type": "object", "required": ["path", "status"], "properties": {
          "path": {"type": "string"}, "status": {"enum": ["production", "placeholder", "missing"]}}}}
      }
    }}
  }
}
